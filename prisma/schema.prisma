generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model Basvuru {
  id               String   @id @default(cuid())
  ogrenciAdSoyad   String
  ogrenciTc        String
  /// Sınav dönemi (örn. "2027-2028"). Aynı öğrenci her dönem bir kez başvurabilir.
  donem            String   @default("2026-2027")
  okul             String
  ogrenciSinifi    String
  ogrenciSube      String   @default("Belirtilmedi")
  sinavGunu        String   @default("Belirtilmedi")
  /// Sınav oturumu (örn. "1. Oturum - 09.30"); sütun canlı veritabanında zaten mevcut
  oturum           String?
  babaAdSoyad      String
  babaMeslek       String
  babaIsAdresi     String   @default("")
  babaCepTel       String
  anneAdSoyad      String
  anneMeslek       String
  anneIsAdresi     String   @default("")
  anneCepTel       String
  adresIl          String   @default("")
  adresIlce        String   @default("")
  adresMahalle     String   @default("")
  adresDetay       String   @default("")
  email            String   @default("")
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt

  @@unique([ogrenciTc, donem])
  @@index([ogrenciTc])
  @@index([donem])
  @@index([email])
}

model Admin {
  id        String   @id @default(cuid())
  email     String   @unique
  password  String
  name      String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model YazOkuluBasvuru {
  id            String   @id @default(cuid())
  ogrenciAd     String
  ogrenciSoyad  String
  okul          String
  ogrenciSinifi String
  veliAd        String
  veliSoyad     String
  veliTelefon   String
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  @@index([createdAt])
  @@index([veliTelefon])
  @@map("yaz_okulu_basvurular")
}
